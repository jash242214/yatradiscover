# YatraDiscover AI - Backend Environment Configuration Template
# Copy this file to .env and fill in the actual values

# ============================================================
# APPLICATION SETTINGS
# ============================================================

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=YatraDiscover AI
PROJECT_VERSION=0.1.0

# ============================================================
# API CONFIGURATION
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Allowed domains for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# API documentation
SWAGGER_URL=/docs
REDOC_URL=/redoc

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Supabase PostgreSQL connection
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Configuration
CORS_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ============================================================
# EXTERNAL SERVICES
# ============================================================

# OpenAI API (for AI itinerary suggestions)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Stripe (for payments)
STRIPE_API_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# SendGrid (for email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yatradiscover.com
SENDGRID_FROM_NAME=YatraDiscover AI

# ============================================================
# REDIS CONFIGURATION
# ============================================================

REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5

# Cache TTL in seconds
CACHE_TTL_SHORT=300        # 5 minutes
CACHE_TTL_MEDIUM=3600      # 1 hour
CACHE_TTL_LONG=86400       # 1 day

# ============================================================
# CELERY CONFIGURATION (Async Tasks)
# ============================================================

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10 MB
LOG_BACKUP_COUNT=5

# ============================================================
# EMAIL CONFIGURATION
# ============================================================

MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_USE_TLS=true
MAIL_FROM=noreply@yatradiscover.com

# ============================================================
# AWS S3 CONFIGURATION (for file uploads)
# ============================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=yatradiscover-files
AWS_S3_ENDPOINT_URL=

# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5
RATE_LIMIT_API_REQUESTS_PER_MINUTE=100

# ============================================================
# CLOUDFLARE CONFIGURATION
# ============================================================

CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_KEY=your-global-api-key

# ============================================================
# MONITORING & ANALYTICS
# ============================================================

SENTRY_DSN=
AMPLITUDE_API_KEY=
ANALYTICS_ENABLED=true

# ============================================================
# FEATURE FLAGS
# ============================================================

FEATURE_AI_SUGGESTIONS=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_PAYMENT_INTEGRATION=true
FEATURE_SOCIAL_SHARING=true
FEATURE_ADMIN_PANEL=true

# ============================================================
# TESTING CONFIGURATION
# ============================================================

TEST_DATABASE_URL=postgresql://user:password@db.supabase.co:5432/test_db
TEST_ENV=false

# ============================================================
# NOTES
# ============================================================

# This file should NEVER be committed to git repository.
# Always use environment variables or secure vaults in production.
# 
# Development Setup:
# 1. Copy this file: cp .env.example .env
# 2. Fill in local values for testing
# 3. For development, you can use placeholder values
#
# Production Setup:
# 1. Use environment variables from your deployment platform
# 2. Never hardcode secrets
# 3. Rotate keys regularly
# 4. Use AWS Secrets Manager or Vault
#
# Security Reminders:
# - Never share .env files via email or version control
# - Use different values for each environment (dev/test/staging/prod)
# - Enable secrets rotation
# - Audit API key usage regularly
