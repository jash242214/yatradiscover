# YatraDiscover AI - Frontend Environment Configuration Template
# Copy this file to .env.local and fill in the actual values

# ============================================================
# API CONFIGURATION
# ============================================================

# Backend API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket endpoint (for real-time updates)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ============================================================
# EXTERNAL SERVICES (Public Keys)
# ============================================================

# Stripe (public key - safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Google Maps API (for location services)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI (for client-side AI features)
NEXT_PUBLIC_OPENAI_ENABLED=true

# ============================================================
# ANALYTICS & MONITORING
# ============================================================

# Google Analytics
NEXT_PUBLIC_GA_ID=G-your-google-analytics-id

# Amplitude
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-key

# Sentry (Error tracking)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Environment
NODE_ENV=development

# App version
NEXT_PUBLIC_APP_VERSION=0.1.0

# Feature flags
NEXT_PUBLIC_FEATURE_BETA_FEATURES=false
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_UI=false

# ============================================================
# CLOUDFLARE & CDN
# ============================================================

# CDN URL (if using Cloudflare or custom CDN)
NEXT_PUBLIC_CDN_URL=https://yatradiscover.com

# Image optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# ============================================================
# SECURITY
# ============================================================

# CORS origin
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# ============================================================
# DEVELOPMENT TOOLS
# ============================================================

# Enable debug logging
NEXT_PUBLIC_DEBUG=true

# Enable mock API responses (for development)
NEXT_PUBLIC_USE_MOCK_API=false

# ============================================================
# NOTES
# ============================================================

# This file should NOT be committed to git repository.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in NEXT_PUBLIC_ variables!
#
# Setup:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in the values based on your environment
# 3. .env.local is loaded automatically by Next.js
#
# Environment Files Priority:
# .env.local > .env.[NODE_ENV].local > .env.[NODE_ENV] > .env
#
# Production:
# Use .env.production.local with production values
# Never commit .env.local or .env.production.local
